-- ==========================================
-- 2. OVERHEAD BILLBOARDGUI
-- ==========================================
local function setupOverhead(character)
	local head = character:WaitForChild("Head", 5)
	if not head then return end

	if head:FindFirstChild("ApexOverhead") then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ApexOverhead"
	billboard.Size = UDim2.new(0, 100, 0, 30)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = head
	billboard.Parent = head

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = character.Name
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.TextSize = 12
	textLabel.Font = Enum.Font.GothamBold
	textLabel.Parent = billboard

	local uiStroke = Instance.new("UIStroke")
	uiStroke.Color = Color3.fromRGB(0, 0, 0)
	uiStroke.Thickness = 2
	uiStroke.Parent = textLabel
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(setupOverhead)
	if player.Character then
		setupOverhead(player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
end

-- ==========================================
-- 3. SICHERES CHAT-SYSTEM
-- ==========================================
local function sendCommand(cmd, playerName)
	local message = string.format(";%s %s", cmd, playerName)
	
	local success = pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		if channels and channels:FindFirstChild("RBXGeneral") then
			channels.RBXGeneral:SendAsync(message)
			return true
		end
		return false
	end)

	if not success then
		pcall(function()
			local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			if events then
				events.SayMessageRequest:FireServer(message, "All")
			end
		end)
	end
end

