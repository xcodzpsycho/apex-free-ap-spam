	ToggleButton.Name = "ApexToggleButton"
	ToggleButton.Size = UDim2.new(0, 45, 0, 45)
	ToggleButton.Position = UDim2.new(0, 20, 0.5, -22)
	ToggleButton.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	ToggleButton.Image = "rbxassetid://123645319057555"
	ToggleButton.Visible = false
	ToggleButton.Active = true
	ToggleButton.Draggable = true

	local tbCorner = Instance.new("UICorner", ToggleButton)
	tbCorner.CornerRadius = UDim.new(1, 0)

	-- ==========================================
	-- X-BUTTON (Fix: ZIndex ganz nach oben gesetzt)
	-- ==========================================
	local closeBtn = Instance.new("TextButton", TopBar)
	closeBtn.Size = UDim2.new(0, 26, 0, 26)
	closeBtn.Position = UDim2.new(1, -32, 0, 4.5)
	closeBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	closeBtn.Text = "X"
	closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeBtn.TextSize = 13
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.ZIndex = 5
	
	local closeCorner = Instance.new("UICorner", closeBtn)
	closeCorner.CornerRadius = UDim.new(0, 6)

	ScrollingFrame = Instance.new("ScrollingFrame")
	ScrollingFrame.Size = UDim2.new(1, -16, 1, -43)
	ScrollingFrame.Position = UDim2.new(0, 8, 0, 38)
	ScrollingFrame.BackgroundTransparency = 1
	ScrollingFrame.BorderSizePixel = 0
	ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	ScrollingFrame.ScrollBarThickness = 4
	ScrollingFrame.ZIndex = 1
	ScrollingFrame.Parent = MainFrame

	local listLayout = Instance.new("UIListLayout", ScrollingFrame)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, padding)

	-- Funktion zur automatischen Anpassung der UI-Größe basierend auf Spielern
	local function updateWindowSize()
		local activePlayers = 0
		for _, child in ipairs(ScrollingFrame:GetChildren()) do
			if child:IsA("Frame") then
				activePlayers = activePlayers + 1
			end
		end

		local visibleRows = math.clamp(activePlayers, 1, maxVisibleRows)
		local contentHeight = (visibleRows * rowHeight) + ((visibleRows - 1) * padding) + 12
		local targetHeight = topBarHeight + contentHeight

		MainFrame.Size = UDim2.new(0, uiWidth, 0, targetHeight)
		ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, (activePlayers * rowHeight) + ((activePlayers - 1) * padding))
	end

	-- Schließen Logik (mit Tween-Animation NUR beim Schließen)
	closeBtn.MouseButton1Click:Connect(function()
		local currentSize = MainFrame.Size
		local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = MainFrame.Position + UDim2.new(0, uiWidth/2, 0, MainFrame.AbsoluteSize.Y/2)
		})
		closeTween:Play()
		closeTween.Completed:Connect(function()
			MainFrame.Visible = false
			MainFrame.Size = currentSize
			MainFrame.Position = UDim2.new(0.5, -uiWidth/2, 0.5, -currentSize.Y.Offset/2)
			ToggleButton.Visible = true
		end)
	end)

	-- Wiederöffnen über das Logo-Icon
	ToggleButton.MouseButton1Click:Connect(function()
		ToggleButton.Visible = false
		MainFrame.Visible = true
	end)

	-- PC-Drag-Logik
	local dragging, dragInput, dragStart, startPos

	TopBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = MainFrame.Position
			
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	TopBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			MainFrame.Position = UDim2.new(
				startPos.X.Scale, 
				startPos.X.Offset + delta.X, 
				startPos.Y.Scale, 
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	-- Spieler Zeile hinzufügen
	local function addPlayerRow(player)
		if player == LocalPlayer then return end

		local row = Instance.new("Frame")
		row.Name = player.Name
		row.Size = UDim2.new(1, -4, 0, rowHeight)
		row.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
		row.BorderSizePixel = 0
		row.ZIndex = 2
		row.Parent = ScrollingFrame

		local rowCorner = Instance.new("UICorner", row)
		rowCorner.CornerRadius = UDim.new(0, 5)

		local nameLabel = Instance.new("TextLabel", row)
		nameLabel.Size = UDim2.new(0, 125, 1, 0)
		nameLabel.Position = UDim2.new(0, 8, 0, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = player.Name
		nameLabel.TextColor3 = Color3.fromRGB(210, 210, 210)
		nameLabel.TextSize = 11
		nameLabel.Font = Enum.Font.Gotham
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
		nameLabel.ZIndex = 2

		local btnContainer = Instance.new("Frame", row)
		btnContainer.Size = UDim2.new(1, -130, 1, 0)
		btnContainer.Position = UDim2.new(0, 125, 0, 0)
		btnContainer.BackgroundTransparency = 1
		btnContainer.BorderSizePixel = 0
		btnContainer.ZIndex = 2

		local btnLayout = Instance.new("UIListLayout", btnContainer)
		btnLayout.FillDirection = Enum.FillDirection.Horizontal
		btnLayout.SortOrder = Enum.SortOrder.LayoutOrder
		btnLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		btnLayout.Padding = UDim.new(0, 3)

		local function createButton(text, color, width)
			local btn = Instance.new("TextButton", btnContainer)
			btn.Size = UDim2.new(0, width, 0, 22)
			btn.BackgroundColor3 = color
			btn.Text = text
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.TextSize = 8.5
			btn.Font = Enum.Font.GothamBold
			btn.ZIndex = 3
			
			local corner = Instance.new("UICorner", btn)
			corner.CornerRadius = UDim.new(0, 4)
			return btn
		end

		createButton("Balloon", Color3.fromRGB(200, 50, 50), 48).MouseButton1Click:Connect(function()
			sendCommand("balloon", player.Name)
		end)

		createButton("Jail", Color3.fromRGB(100, 100, 100), 32).MouseButton1Click:Connect(function()
			sendCommand("jail", player.Name)
		end)

		createButton("Ragdoll", Color3.fromRGB(150, 75, 0), 48).MouseButton1Click:Connect(function()
			sendCommand("ragdoll", player.Name)
		end)

		createButton("Rocket", Color3.fromRGB(50, 150, 200), 44).MouseButton1Click:Connect(function()
			sendCommand("rocket", player.Name)
		end)

		createButton("Control", Color3.fromRGB(50, 200, 100), 46).MouseButton1Click:Connect(function()
			sendCommand("control", player.Name)
		end)

		createButton("AP-SPAM", Color3.fromRGB(220, 100, 0), 50).MouseButton1Click:Connect(function()
			local cmds = {"ragdoll", "rocket", "inverse", "balloon", "jail", "tiny", "morph", "jumpscare"}
			task.spawn(function()
				for _, cmd in ipairs(cmds) do
					sendCommand(cmd, player.Name)
					task.wait(0.1)
				end
			end)
		end)

		updateWindowSize()
	end

	for _, player in ipairs(Players:GetPlayers()) do
		addPlayerRow(player)
	end

	Players.PlayerAdded:Connect(addPlayerRow)

	Players.PlayerRemoving:Connect(function(player)
		local row = ScrollingFrame:FindFirstChild(player.Name)
		if row then
			row:Destroy()
			updateWindowSize()
		end
	end)
end

